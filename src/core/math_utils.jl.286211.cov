        - # Shared Mathematical & Statistical Utilities
        - 
        - """
        -     sample_triangular(rng::AbstractRNG, a::Float64, b::Float64, c::Float64)
        - 
        - Sample from a Triangular distribution with minimum `a`, mode `b`, and maximum `c`.
        - """
   119902 function sample_triangular(rng::AbstractRNG, a::Float64, b::Float64, c::Float64)::Float64
   119902     if c <= a
        2         return a
        -     end
   239800     b_clamped = clamp(b, a, c)
   119900     u = rand(rng)
   119900     fc = (b_clamped - a) / (c - a)
   119900     if u < fc
    50746         return a + sqrt(u * (c - a) * (b_clamped - a))
        -     else
    69154         return c - sqrt((1.0 - u) * (c - a) * (c - b_clamped))
        -     end
        - end
        - 
        - """
        -     sample_lognormal_from_ci(rng::AbstractRNG, p10::Float64, p90::Float64)
        - 
        - Sample from a LogNormal distribution parameterized by its 10th and 90th percentiles (`p10` and `p90`).
        - """
     7500 function sample_lognormal_from_ci(rng::AbstractRNG, p10::Float64, p90::Float64)::Float64
     7500     z90 = 1.2815515655446004
     7500     lp10 = log(max(p10, 1e-6))
     7500     lp90 = log(max(p90, 1e-6))
     7500     mu = 0.5 * (lp10 + lp90)
     7500     sigma = max(0.0, (lp90 - lp10) / (2.0 * z90))
     7500     return exp(mu + sigma * randn(rng))
        - end
        - 
        - """
        -     logistic_adoption(t::Int, ceiling::Float64, t0::Float64, k::Float64)
        - 
        - Computes the S-curve adoption fraction at month `t`.
        - """
        3 @inline function logistic_adoption(t::Int, ceiling::Float64, t0::Float64, k::Float64)::Float64
   749163     raw = 1.0 / (1.0 + exp(-k * (Float64(t) - t0)))
   749163     return ceiling * raw
        - end
        - 
        - """
        -     j_curve_dip(t::Int, t0::Float64, dip_depth::Float64)
        - 
        - Models temporary onboarding/workflow friction that peaks around `t0 - 2.5` and decays.
        - """
        2 @inline function j_curve_dip(t::Int, t0::Float64, dip_depth::Float64)::Float64
   748802     center = max(2.0, t0 - 2.5)
   748802     width = 3.2
   748802     z = (Float64(t) - center) / width
   748802     return dip_depth * exp(-0.5 * z * z)
        - end
