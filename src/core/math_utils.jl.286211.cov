        - """
        -     quantile_summary(v::AbstractVector{Float64}; digits::Int=1)
        - 
        - Returns a standard dictionary of P05, P10, P25, P50, P75, P90, P95, mean, and std.
        - """
     1142 function quantile_summary(v::AbstractVector{Float64}; digits::Int=1)
      571     return Dict{String, Any}(
        -         "p05" => round(quantile(v, 0.05), digits=digits),
        -         "p10" => round(quantile(v, 0.10), digits=digits),
        -         "p25" => round(quantile(v, 0.25), digits=digits),
        -         "p50" => round(quantile(v, 0.50), digits=digits),
        -         "p75" => round(quantile(v, 0.75), digits=digits),
        -         "p90" => round(quantile(v, 0.90), digits=digits),
        -         "p95" => round(quantile(v, 0.95), digits=digits),
        -         "mean" => round(mean(v), digits=digits),
        -         "std" => round(std(v), digits=digits)
        -     )
        - end
        - 
        - """
        -     matrix_quantiles(mat::Matrix{Float64}; digits::Int=1)
        - 
        - Computes column-wise P10, P25, P50, P75, P90, and mean across trials for each time step.
        - """
      282 function matrix_quantiles(mat::Matrix{Float64}; digits::Int=1)
      141     horizon = size(mat, 2)
      141     return Dict{String, Any}(
        -         "p10" => [round(quantile(view(mat, :, m), 0.10), digits=digits) for m in 1:horizon],
        -         "p25" => [round(quantile(view(mat, :, m), 0.25), digits=digits) for m in 1:horizon],
        -         "p50" => [round(quantile(view(mat, :, m), 0.50), digits=digits) for m in 1:horizon],
        -         "p75" => [round(quantile(view(mat, :, m), 0.75), digits=digits) for m in 1:horizon],
        -         "p90" => [round(quantile(view(mat, :, m), 0.90), digits=digits) for m in 1:horizon],
        -         "mean" => [round(mean(view(mat, :, m)), digits=digits) for m in 1:horizon]
        -     )
        - end
        - 
        - """
        -     build_histogram(data::AbstractVector{Float64}, n_bins::Int, min_val::Float64, max_val::Float64)
        - 
        - Constructs a binned histogram dictionary for static JSON plotting.
        - """
       22 function build_histogram(data::AbstractVector{Float64}, n_bins::Int, min_val::Float64, max_val::Float64)
       22     lo = min(min_val, minimum(data))
       22     hi = max(max_val, maximum(data))
       22     if hi <= lo
        1         hi = lo + 1.0
        -     end
       22     step = (hi - lo) / n_bins
       22     edges = [round(lo + i * step, digits=1) for i in 0:n_bins]
       22     mids = [round(lo + (i + 0.5) * step, digits=1) for i in 0:(n_bins - 1)]
      575     counts = zeros(Int, n_bins)
       22     n = length(data)
       22     for x in data
    21023         idx = clamp(floor(Int, (x - lo) / step) + 1, 1, n_bins)
    10520         counts[idx] += 1
    10520     end
       22     densities = [round((c / n) * 100.0, digits=2) for c in counts]
       22     return Dict{String, Any}(
        -         "bin_edges" => edges,
        -         "bin_midpoints" => mids,
        -         "counts" => counts,
        -         "pct_of_trials" => densities
        -     )
        - end
