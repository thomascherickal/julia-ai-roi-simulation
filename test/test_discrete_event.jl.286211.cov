        1 @testset "Paradigm 4: Discrete Event Simulation (DES) Queueing Engine" begin
        2     rng = MersenneTwister(2026)
        - 
        -     # Edge case: 0 items or 0 servers
        1     w0, s0, p0, u0 = simulate_stage_queue(rng, 0, 5, 2.0, 1.0)
        2     @test w0 == 0.0 && u0 == 0.0
        - 
        -     # Queue congestion test: fewer servers -> higher utilization and longer wait time
        1     w_many_srv, _, _, u_many_srv = simulate_stage_queue(MersenneTwister(11), 400, 12, 2.5, 3.0)
        1     w_few_srv, _, _, u_few_srv = simulate_stage_queue(MersenneTwister(11), 400, 4, 2.5, 3.0)
        1     @test u_few_srv > u_many_srv
        1     @test w_few_srv >= w_many_srv
        - 
        1     for sc in DEFAULT_SCENARIOS
        4         des = run_discrete_event_model(sc; horizon_months=36, seed=808)
        4         @test des["paradigm"] == "discrete_event"
        4         @test length(des["workflows"]) == 4
        4         @test des["kpis"]["total_hours_saved_36m"] > 0.0
        4     end
        - 
        -     # Verify QA capacity reallocation reduces Month-36 QA wait time
        1     sc_blitz = DEFAULT_SCENARIOS[2] # blitzscale_mandate
        1     des_no_realloc = run_discrete_event_model(sc_blitz; seed=42, qa_capacity_reallocation=0.0)
        1     des_with_realloc = run_discrete_event_model(sc_blitz; seed=42, qa_capacity_reallocation=0.10)
        1     @test des_with_realloc["kpis"]["m36_qa_queue_wait_hrs"] <= des_no_realloc["kpis"]["m36_qa_queue_wait_hrs"]
        - end
