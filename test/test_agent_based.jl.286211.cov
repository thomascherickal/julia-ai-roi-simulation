        1 @testset "Paradigm 2: Agent-Based Modeling (ABM) Engine" begin
        2     for sc in DEFAULT_SCENARIOS
        4         abm = run_agent_based_model(sc; n_replications=40, horizon_months=36, seed=555)
        4         @test abm["paradigm"] == "agent_based"
        4         @test abm["parameters"]["total_agents"] == 325
        - 
        -         # Verify state fractions sum to ~100% at every month across the mean trajectory
        4         st = abm["state_trajectories"]
        4         for m in 1:36
      144             total_pct = st["skeptical_pct"]["mean"][m] +
        -                         st["exploring_pct"]["mean"][m] +
        -                         st["proficient_pct"]["mean"][m] +
        -                         st["champion_pct"]["mean"][m] +
        -                         st["disillusioned_pct"]["mean"][m]
      144             @test isapprox(total_pct, 100.0; atol=0.5)
      284         end
        - 
        -         # Verify network snapshot nodes & edges exist
        4         @test length(abm["network_snapshot"]["nodes"]) == 48
        4         @test !isempty(abm["network_snapshot"]["edges"])
        4     end
        - 
        -     # Test explicit parameter overrides: high champion seeding vs zero champion seeding
        1     sc = DEFAULT_SCENARIOS[1]
        1     abm_low_seed = run_agent_based_model(sc; n_replications=30, seed=99, champion_seed_fraction=0.01, peer_contagion_strength=0.20, frustration_sensitivity=0.25)
        1     abm_high_seed = run_agent_based_model(sc; n_replications=30, seed=99, champion_seed_fraction=0.15, peer_contagion_strength=0.55, frustration_sensitivity=0.03)
        - 
        1     @test abm_high_seed["kpis"]["m36_active_adopters_pct"]["p50"] > abm_low_seed["kpis"]["m36_active_adopters_pct"]["p50"]
        1     @test abm_high_seed["kpis"]["m36_disillusioned_churn_pct"]["p50"] < abm_low_seed["kpis"]["m36_disillusioned_churn_pct"]["p50"]
        - end
